# Active production settings. Copy to frontend/.env.local for Next.js.
# Optional absolute repository root; default is the parent of the frontend cwd.
PITWALL_PROJECT_ROOT=
# Optional explicitly trusted HTTPS directory containing data_cache/product.json.
# Local missing files alone may use this source; corrupt local data fails closed.
PITWALL_DATA_BASE_URL=
# Session timing
F1_TIMING_RATE_LIMIT_MS=5000
PITWALL_TIMING_AUTO_SELECT=true
LIVE_TIMING_ENABLED=true
DISABLE_LIVE_MODE=false

# Production rankings require no API keys, AI credentials, or email credentials.
# Legacy monolith environment variables do not control production publication.
